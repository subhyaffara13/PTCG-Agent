# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Kaggle credentials (never commit these)
kaggle.json
~/.kaggle/

# Logs (keep structure, ignore content)
logs/

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Secrets / env
.env
*.env

# Runtime game dumps & iteration results
cabt_game_dump.json
iteration_result.json
*_vs_*.json

# Staging (ephemeral build artifacts)
staging/

# Submission tarballs (binary artifacts, not source)
*.tar.gz
*.zip

# Visualizer generated data (auto-exported, not source)
visualizer/data/

# Submission mirror (generated by build_submission.py)
submission/agents/
submission/router/
submission/skills/
submission/manifest.json

# Exclude large reference PDF
skills/card_pool_reference.pdf
